# Base URL of the backend, without a trailing slash and without /api/v1.
# Server-side only: do not prefix with NEXT_PUBLIC_.
API_BASE_URL=http://localhost:8000

# Required, at least 32 characters. Encrypts the session cookie.
# Generate with: openssl rand -base64 32
# Server-side only: do not prefix with NEXT_PUBLIC_.
SESSION_SECRET=
