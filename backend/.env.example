# Shared code sent by clients in the X-Access-Code header. Requests fail if unset.
ACCESS_CODE=

# Absolute path to the tickets CSV. Keep this file outside the repository.
RIDEOPS_DATA_PATH=

# SQLite by default. Use a postgresql:// URL for durable storage.
DATABASE_URL=sqlite:///./rideops.db

# Replace client and agent names with aliases in all responses.
MASK_NAMES=false
